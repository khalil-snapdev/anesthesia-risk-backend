ENVIRONMENT=development
LOG_LEVEL=INFO
# MongoDB Atlas connection string added in step 1.2
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Google OAuth client ID (from Google Cloud Console) — verifies the
# audience claim on Google Sign-In ID tokens.
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# Optional: if unset, a random secret is generated per process (fine for
# local dev, NOT safe for production — see app/config.py). Set a real,
# stable value here in production.
# JWT_SECRET_KEY=
# JWT_EXPIRY_MINUTES=1440
